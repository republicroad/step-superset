# ============================================================
# step-superset 本地凭据模板
#
# 使用方法：
#   cp .env.example .env   然后填入真实值
#   .env 已被 .gitignore 排除，永不提交
#   compose 会把本文件只读挂载到容器 /app/.env，
#   scripts/ 下的验证脚本自动从这里读取，无需手工传环境变量
#   compose 会自动读取仓库根目录的 .env 文件（本文件）做变量替换
#
# 分工说明：
#   - Superset 自身的 SECRET_KEY / ADMIN_PASSWORD / 元数据库密码
#     直接写在 docker-compose.yml 内（示例值，可按需覆盖）
#   - 本文件只放「数据源凭据」：MaxCompute 与 DuckDB 对象存储
# ============================================================

# ------------------------------------------------------------
# MaxCompute（阿里云）
# 来源：本机 odpscmd 的 conf/odps_config.ini（access_id / access_key）
# 或在 RAM 控制台为 BI 场景单独创建最小权限 AK（只授 Select/Download）
# 注意：AK 含 / + = 等特殊字符时，填入 Superset 连接串前需 URL 编码
# ------------------------------------------------------------
MC_AK_ID=
MC_AK_SECRET=
MC_PROJECT=
MC_ENDPOINT=http://service.cn-shenzhen.maxcompute.aliyun.com/api

# Superset 管理员（一键两用：compose init 建号 + 验证脚本登录；与 compose 键名一致）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ------------------------------------------------------------
# Superset MCP 服务（docs/mcp.md；compose 内 superset_mcp 常驻服务，
# 端口 5008 仅限本机/内网，公网部署删除端口映射并走反代 TLS 收口）
#
# 开发模式（仅本机）：MCP_DEV_MODE=true 后，未认证的工具调用一律以
#   MCP_DEV_USERNAME 身份执行（该用户必须已存在于 Superset）。
#   公网部署必须关闭（红线），改用 JWT。
# 生产模式：MCP_AUTH_ENABLED=true，JWT/JWKS 校验，sub 解析为 Superset
#   用户，RBAC/RLS 逐用户生效；scope 见 MCP_REQUIRED_SCOPES。
# 密钥只经环境变量注入，严禁写进任何文件入仓库。
# ------------------------------------------------------------
MCP_DEV_MODE=true
MCP_DEV_USERNAME=admin
# MCP_AUTH_ENABLED=false
# MCP_JWT_ALGORITHM=RS256
# MCP_JWKS_URI=https://<身份提供方>/.well-known/jwks.json
# MCP_JWT_ISSUER=https://<身份提供方>/
# MCP_JWT_AUDIENCE=superset-mcp
# MCP_REQUIRED_SCOPES=mcp:read

# ------------------------------------------------------------
# 数据库引擎补丁总开关（推荐 true；见 docs/duckdb.md 三层闸门）
# true = 每个连接建立时自动执行「白名单 → 关总闸 → 上锁」序列
# false = 关闭保护，Superset 行为与官方镜像一致（不建议）
# 兼容说明：旧键名 DUCKDB_SECURITY_HOOK 仍可读取，新键名优先
# ------------------------------------------------------------
ENGINE_PATCHES_ENABLED=true

# ------------------------------------------------------------
# DuckDB 对象存储（S3 / OSS 兼容端点，可选）
# 填写后白名单自动扩展到 S3 前缀（走 httpfs + 会话内 secret）
# OSS 兼容端点示例格式：oss-cn-shenzhen.aliyuncs.com
# 注意：ENDPOINT 区域必须与桶所在区域一致
# ------------------------------------------------------------
DUCKDB_S3_ENDPOINT=
DUCKDB_S3_REGION=
DUCKDB_S3_KEY_ID=
DUCKDB_S3_SECRET=
DUCKDB_S3_BUCKET_PREFIX=s3://<bucket>/<prefix>/
# 可选，默认即 vhost + SSL true（显式写出便于后续切换 RustFS/MinIO 等兼容存储）
# RustFS 若要求路径式访问，改 DUCKDB_S3_URL_STYLE=path 即可
DUCKDB_S3_URL_STYLE=vhost
DUCKDB_S3_USE_SSL=true

# ------------------------------------------------------------
# DuckDB 安全白名单（目录级，逗号分隔）
# 三层闸门详见 docs/duckdb.md；默认只放行容器内演示数据目录
# ------------------------------------------------------------
DUCKDB_ALLOWED_DIRECTORIES=/data/duckdb
